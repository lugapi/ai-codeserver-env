# =============================================================================
# Local development only — used with docker-compose.local.yml
# =============================================================================
# Coolify does NOT read this file. On Coolify, PASSWORD is auto-generated
# via the magic variable SERVICE_PASSWORD_CODESERVER in docker-compose.yaml.
#
# Quick start:
#   cp .env.example .env
#   docker compose -f docker-compose.yaml -f docker-compose.local.yml up -d --build

# Required for local dev — code-server login password
PASSWORD=change-me-to-a-strong-password

# Host port when running locally
PORT=8080

# Set to "true" to re-install/update VS Code extensions on every container start.
OPTIONAL_EXTENSION_UPDATE=false
